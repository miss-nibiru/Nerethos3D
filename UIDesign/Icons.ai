         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Icons</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Beautiful colorful square buttons with light border. Vector assets for web or game design. Decorative GUI elements, isolated on blue background.</rdf:li>
            </rdf:Alt>
         </dc:description>
